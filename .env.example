# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# CORS (comma-separated origins, or * for all)
CORS_ORIGINS=*

# Database - Local (sql.js, no config needed)
# DB_PATH=./data/verifier.db

# Database - Turso (production, free tier: 9GB)
# Sign up at https://turso.tech and create a database
# TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
# TURSO_AUTH_TOKEN=your-auth-token

# Logging (debug | info | warn | error)
LOG_LEVEL=info

# Admin key for key management endpoints (generate a strong random string)
ADMIN_KEY=change-me-to-a-secure-random-string
