# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# CORS (comma-separated origins, or * for all)
CORS_ORIGINS=*

# Database
DB_PATH=./data/verifier.db

# Logging (debug | info | warn | error)
LOG_LEVEL=info

# Rate Limiting (per key, overrides tier defaults)
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX_REQUESTS=60

# Admin key for key management endpoints (generate one and keep secret)
ADMIN_KEY=change-me-to-a-secure-random-string
